<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Color ink paper. The window is repainted per ink at runtime; this only avoids a
         flash of the wrong colour during cold start. -->
    <color name="paper">#FFF4F1EA</color>
    <style name="Theme.Book" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:colorAccent">#FF2B4C7E</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
    <style name="Theme.Book.Reader">
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>
</resources>
