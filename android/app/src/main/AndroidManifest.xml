<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Books arrive through the Storage Access Framework (folder or file picker), so no
         storage permission is requested. -->

    <!-- Free catalogs (OPDS) and cover / author lookups (Open Library, optional). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Swipe down on Home pulls down the notification shade, as on other home screens. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- Home's "reading vs work vs scrolling" split. Granted by the user in Settings → Usage
         access; the data never leaves the phone. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Uninstall from the app list's long-press menu (ACTION_DELETE). A normal permission,
         granted automatically at install; without it the system uninstaller opens and closes
         immediately with no error. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Tapping the clock opens the clock app's alarm list (SHOW_ALARMS). AOSP's clock, and the
         clocks built on it, refuse that request from apps that don't hold this; it is a normal
         permission, granted at install, and ReadFirst never sets an alarm itself. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- The ringer control (Home's RING / VIB / SILENT label, the quick-settings tile, the
         notification buttons). Android lets an app switch Silent on or off only with Do Not
         Disturb access; declaring this is what lists ReadFirst on that settings page, where the
         user grants it. Ring and vibrate work without it. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- The optional pinned notification with Ring / Vibrate / Silent buttons. Off by default,
         and only asked for at the moment it is switched on in Settings, never at startup. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Puts that notification back after the phone restarts. Does nothing while it is off. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Launcher package visibility without QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Which app answers the clock tap, so it can be opened by its icon if it refuses. -->
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <!-- TorchLevels, the companion app that keeps the reading timer's countdown, where it
             is installed (see data/FlipTimer.kt). Nothing is assumed where it isn't. -->
        <package android:name="dev.m42.torchlevels" />
        <provider android:authorities="dev.m42.torchlevels.timer" />
    </queries>

    <application
        android:name=".ReadFirstApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Book"
        android:enableOnBackInvokedCallback="false"
        tools:targetApi="36">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|navigation|uiMode"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Only used to read active media sessions (Now listening); notifications are ignored. -->
        <service
            android:name=".data.MediaAccessService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Fires the audiobook sleep timer; inexact, so it needs no special permission. -->
        <receiver android:name=".data.SleepTimer$Receiver" android:exported="false" />

        <!-- Quick-settings tile: each tap moves the ringer on, ring → vibrate → silent. -->
        <service
            android:name=".data.RingerTile"
            android:exported="true"
            android:icon="@drawable/ic_ringer_ring"
            android:label="@string/ringer_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- StandBy, a screen saver for the phone while it charges: clock, date, battery, alarm,
             weather, timer and the current book. Chosen by the user under Settings → Display →
             Screen saver; only the system can start it, and it needs no permission of its own. -->
        <service
            android:name=".standby.StandbyDream"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/standby_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- The buttons on the pinned ringer notification; reachable only by ReadFirst itself. -->
        <receiver android:name=".data.RingerNotification$ActionReceiver" android:exported="false" />

        <!-- Re-posts that notification after a restart or an update. Not exported: the system
             may still deliver these to it, other apps may not. -->
        <receiver android:name=".data.RingerNotification$BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The companion widget for people who keep their own home screen. -->
        <receiver
            android:name=".widget.ReadingWidget"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/reading_widget_info" />
        </receiver>

        <activity
            android:name=".BookToggleActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="" />

        <activity
            android:name=".reader.ReaderActivity"
            android:exported="false"
            android:theme="@style/Theme.Book.Reader"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|navigation|uiMode" />
    </application>
</manifest>
